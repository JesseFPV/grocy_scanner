# Example systemd service file for Intake
# Copy this to /etc/systemd/system/intake.service
# Then run: sudo systemctl enable intake.service
#          sudo systemctl start intake.service
#
# See INSTALLATION.md for complete installation instructions
#
# IMPORTANT: This service file uses the virtual environment Python.
# Make sure you have created the venv before using this service file.

[Unit]
Description=Intake Application
After=network.target graphical.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/grocy_scanner
Environment=DISPLAY=:0
ExecStart=/home/pi/grocy_scanner/venv/bin/python /home/pi/grocy_scanner/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target

